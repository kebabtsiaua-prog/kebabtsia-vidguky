{
  "manifest_version": 3,
  "name": "Кебабця: відгуки Glovo і Bolt",
  "version": "1.2",
  "description": "Щовечора забирає відгуки з Glovo і Bolt і надсилає їх боту «Відгуки Кебабця».",
  "permissions": [
    "alarms",
    "downloads",
    "storage"
  ],
  "host_permissions": [
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://portal.glovoapp.com/*"
      ],
      "js": [
        "page.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://portal.glovoapp.com/*"
      ],
      "js": [
        "relay.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://foodpartner.bolt.eu/*"
      ],
      "js": [
        "bolt.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Відгуки Glovo і Bolt",
    "default_icon": "icon.png"
  },
  "icons": {
    "128": "icon.png"
  }
}
